# syntax=docker/dockerfile:1

# Self-contained production image for the freight platform:
# nginx + PHP-FPM serve Laravel, and supervisor also runs the queue worker
# and the scheduler. Network access is only needed while building (Composer,
# npm and base images). The running container needs no external services.

ARG PHP_VERSION=8.3
ARG NODE_VERSION=22

# 1) PHP runtime with every extension the application needs
FROM php:${PHP_VERSION}-fpm-alpine AS base

RUN set -eux; \
    apk add --no-cache \
        nginx \
        supervisor \
        icu-libs \
        icu-data-full \
        libzip \
        libpng \
        libjpeg-turbo \
        libwebp \
        freetype; \
    apk add --no-cache --virtual .build-deps \
        $PHPIZE_DEPS \
        icu-dev \
        libzip-dev \
        libpng-dev \
        libjpeg-turbo-dev \
        libwebp-dev \
        freetype-dev; \
    docker-php-ext-configure gd --with-freetype --with-jpeg --with-webp; \
    docker-php-ext-install -j"$(nproc)" pdo_mysql intl bcmath gd zip exif opcache pcntl; \
    apk del .build-deps; \
    cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"; \
    php -m

# 2) Composer dependencies (production only) and the optimized autoloader
FROM base AS vendor

RUN apk add --no-cache git unzip
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
ENV COMPOSER_ALLOW_SUPERUSER=1 \
    COMPOSER_NO_INTERACTION=1

# Optional Packagist mirror for restricted networks (build time only).
ARG COMPOSER_MIRROR=""
RUN if [ -n "$COMPOSER_MIRROR" ]; then composer config -g repos.packagist composer "$COMPOSER_MIRROR"; fi

WORKDIR /app

# composer.lock is optional. Without it, dependencies are resolved here.
# CI passes the lockfile generated by its test job so the image uses the
# same dependency versions that passed the tests.
COPY composer.json composer.lock* ./
RUN if [ -f composer.lock ]; then \
        composer install --no-dev --no-scripts --no-autoloader --prefer-dist --no-progress; \
    else \
        composer update --no-dev --no-scripts --no-autoloader --prefer-dist --no-progress; \
    fi

COPY . .
# dump-autoload runs the post-autoload-dump scripts: package:discover and
# filament:upgrade (which publishes Filament assets into public/).
RUN set -eux; \
    mkdir -p bootstrap/cache storage/framework/cache/data storage/framework/sessions storage/framework/views storage/logs storage/app/private; \
    composer dump-autoload --no-dev --optimize; \
    test -d public/js/filament

# 3) Frontend assets (Tailwind CSS, app JS and the local Vazirmatn font)
FROM node:${NODE_VERSION}-alpine AS assets

WORKDIR /app
COPY package.json package-lock.json* .npmrc ./
# Optional npm registry mirror for restricted networks (build time only).
ARG NPM_REGISTRY=""
RUN if [ -n "$NPM_REGISTRY" ]; then npm config set registry "$NPM_REGISTRY"; fi
RUN if [ -f package-lock.json ]; then \
        npm ci --no-audit --no-fund; \
    else \
        npm install --no-audit --no-fund; \
    fi

COPY vite.config.js ./
COPY resources ./resources
COPY app ./app
# Tailwind scans Laravel's pagination views for class names.
COPY --from=vendor /app/vendor/laravel/framework/src/Illuminate/Pagination/resources/views ./vendor/laravel/framework/src/Illuminate/Pagination/resources/views
RUN mkdir -p storage/framework/views && npm run build

# 4) Runtime image
FROM base AS runtime

# Used by deploy.sh to prune only this project's old images.
LABEL app.sirdadfar.project="sirdadfar-saas-starter"

WORKDIR /var/www/html

COPY docker/php.ini "$PHP_INI_DIR/conf.d/zz-app.ini"
COPY docker/php-fpm.conf /usr/local/etc/php-fpm.d/zz-app.conf
COPY docker/nginx.conf /etc/nginx/nginx.conf
COPY docker/supervisord.conf /etc/supervisord.conf
COPY docker/entrypoint.sh /usr/local/bin/entrypoint

# Application code stays owned by root (read only for the web user). Only
# storage and bootstrap/cache are writable.
COPY --from=vendor /app ./
COPY --from=assets /app/public/build ./public/build

RUN set -eux; \
    chmod 755 /usr/local/bin/entrypoint; \
    rm -f public/hot; \
    mkdir -p storage/framework/cache/data storage/framework/sessions storage/framework/views storage/logs storage/app/private bootstrap/cache; \
    chown -R www-data:www-data storage bootstrap/cache /var/lib/nginx /var/log/nginx; \
    test -f public/build/manifest.json

ENV APP_ENV=production \
    APP_DEBUG=false \
    LOG_CHANNEL=stderr \
    RUN_MIGRATIONS=true \
    RUN_SEEDERS=false

USER www-data

EXPOSE 8080

HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:8080/up || exit 1

ENTRYPOINT ["entrypoint"]
CMD ["supervisord", "-c", "/etc/supervisord.conf"]
